Options -Indexes
RewriteEngine On
RewriteRule ^(app|config|database|resources|routes|storage|design-reference)(/|$) - [F,L]
RewriteRule (^|/)\.(env|git) - [F,L]
RewriteRule \.(sql|log|bak|zip)$ - [F,L,NC]
RewriteRule ^$ public/ [L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
